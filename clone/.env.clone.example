# Configuration for the stack-clone tooling (clone/clone.sh).
#
# This checkout is the clone's DESTINATION. The tooling makes a faithful 1:1
# copy of a v1 (1.x itk-dev) source — its env files, media and jwt keypair —
# in here, retargeted to a new domain and database. It does NOT convert to v3;
# run the v3 migration tooling afterwards (clone.sh prints the steps).
#
# Copy to `clone/.env.clone` (gitignored) and edit. `clone.sh` loads it
# automatically; values set in the environment when you run the task still
# override what's here, e.g.:
#
#   DOMAIN=other.example.com task -t clone/Taskfile.yml clone
#
# Bootstrap with:  task -t clone/Taskfile.yml init   (copies this file)

# -- Required ----------------------------------------------------------------

# The v1 stack to clone FROM — its root, the directory holding
# .env.docker.local (with APP_DATABASE_URL). Relative paths are resolved from
# this checkout's root. The source is only read (plus one database dump); it is
# never modified.
SOURCE=/data/www/os2display_itkdev_dk/htdocs

# Public domain the converted clone will serve.
DOMAIN=staging.os2display.example.com

# The clone's database. MUST point at a DIFFERENT database than the source —
# clone.sh aborts if it matches. The source dump is restored into it.
#
# To put the clone on the SAME server as the source, leave this as-is and run
# `task -t clone/Taskfile.yml create-db` — it provisions the database and
# rewrites this line for you (prompting for the DB admin/root password).
CLONE_DATABASE_URL=mysql://user:pass@your-db-host:3306/os2display_staging?serverVersion=mariadb-11.4.10-MariaDB

# -- Optional ----------------------------------------------------------------

# Compose project name written into the clone's env. Leave blank to derive a
# sanitised name from this checkout's directory name.
CLONE_PROJECT=
