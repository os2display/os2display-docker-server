# Configuration for the stack-clone tooling (clone/clone.sh).
#
# This checkout is the clone's DESTINATION — the tooling pulls the source
# stack's env files, media and jwt keypair in here and rewrites them.
#
# Copy to `clone/.env.clone` (gitignored) and edit. `clone.sh` loads it
# automatically; values set in the environment when you run the task still
# override what's here, e.g.:
#
#   DOMAIN=other.example.com task -t clone/Taskfile.yml clone
#
# Bootstrap with:  task -t clone/Taskfile.yml init   (copies this file)

# -- Required ----------------------------------------------------------------

# The stack to clone FROM — its root, the directory holding .env /
# .env.symfony / docker-compose.yml. Relative paths are resolved from this
# checkout's root. The source is only read (plus one database dump); it is
# never modified.
SOURCE=../os2display

# Public domain the clone serves. The source's running traefik routes this
# host to the clone's nginx-api.
DOMAIN=staging.os2display.example.com

# The clone's database. MUST point at a DIFFERENT database than the source —
# clone.sh aborts if it matches. Created if missing (needs CREATE privilege);
# the source dump is loaded into it.
#
# To put the clone on the SAME server as the source, leave this as-is and run
# `task -t clone/Taskfile.yml create-db` — it provisions the database and
# rewrites this line for you (prompting for the DB admin/root password).
CLONE_DATABASE_URL=mysql://user:pass@your-db-host:3306/os2display_staging?serverVersion=mariadb-11.4.10-MariaDB

# -- Optional ----------------------------------------------------------------

# Compose project name (container/volume namespace) for the clone. Leave blank
# to derive a sanitised name from this checkout's directory name.
CLONE_PROJECT=

# The docker network the running traefik is attached to (the clone joins it
# instead of creating its own). Leave blank to use the source's
# OS2DISPLAY_FRONTEND_NETWORK, falling back to "frontend".
FRONTEND_NETWORK=
