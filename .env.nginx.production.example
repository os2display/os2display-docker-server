# Nginx runtime environment for the os2display api-service-nginx image.
#
# OS-level / runtime tuning consumed at container start by the nginx image's
# template-rendered config (/etc/nginx/templates/default.conf.template).
# Symfony application config is unrelated and lives in .env.symfony.
#
# The image ships sensible defaults — operators only need to override what
# their workload actually demands. Most installs only touch NGINX_MAX_BODY_SIZE.

###
# Request limits
###
# Max request body size accepted by nginx. Must be >= PHP_UPLOAD_MAX_FILESIZE
# in .env.php, otherwise large uploads get truncated at the proxy. Default: 140m.
NGINX_MAX_BODY_SIZE=140m

###
# Upstream FPM (rarely needs tuning — only useful with custom topology)
###
# FPM service hostname (the docker-compose service name). Default: os2display.
#NGINX_FPM_SERVICE=os2display
# FPM listen port. Default: 9000.
#NGINX_FPM_PORT=9000

###
# Listen / proxy chain
###
# Nginx listen port (inside the container; traefik connects to this). Default: 8080.
#NGINX_PORT=8080
# CIDR(s) trusted for X-Forwarded-* headers. Default covers all RFC-1918
# private space (172.16.0.0/12). Override if your proxy chain is on a
# different network.
#NGINX_SET_REAL_IP_FROM=172.16.0.0/12
# Document root. Default: /var/www/html/public.
#NGINX_WEB_ROOT=/var/www/html/public
