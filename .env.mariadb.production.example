# MariaDB runtime environment for the bundled mariadb service.
#
# Consumed at container start by the official mariadb image's entrypoint to
# initialise the data dir on first boot. Used only when COMPOSE_PROFILES
# contains `mariadb`.
#
# IMPORTANT: these credentials must match the DATABASE_URL in .env.symfony.
# Doctrine connects via DATABASE_URL; mariadb itself reads these. Operators
# upgrading from an existing data directory must keep these unchanged or
# the container won't start (the entrypoint refuses to re-initialise).

# Application database name.
MARIADB_DATABASE=db
# Application database user (Doctrine connects as this user).
MARIADB_USER=db
# Application user password. CHANGE BEFORE FIRST INSTALL.
MARIADB_PASSWORD=db
# Root password for administrative tasks (mariadb-upgrade, mariadb-dump, etc.).
# CHANGE BEFORE FIRST INSTALL.
MARIADB_ROOT_PASSWORD=dbrootpassword
