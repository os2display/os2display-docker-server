# =============================================================================
#  Example .env file for os2display-docker-server
#  Cantains environment variables that needs local configuration. 
#  Copy this file to .env.docker and adjust the values as needed for your setup.
#  Lines starting with # are comments.
# =============================================================================

# =========================== OS2display values ===============================
# The domain name where the OS2display application will be accessible (e.g., os2display.example.com)
OS2DISPLAY_DOMAIN=demo.os2display.dk

# Version of itkdev/os2display-api-service
# Find the latest version here: https://hub.docker.com/r/itkdev/os2display-api-service/tags
# Use OS2DISPLAY_VERSION=develop if you want to install the dev-branch.
OS2DISPLAY_VERSION=develop

# List the templates you want to load.
# Find all available templates here: https://github.com/os2display/display-templates/tree/develop/src
OS2DISPLAY_TEMPLATES="book-review,calendar,contacts,iframe,image-text,instagram-feed,poster,rss,slideshow,table,travel,video"

# List the screen layouts you want to load. 
# Find all available templates here: https://github.com/os2display/display-templates/tree/develop/src/screen-layouts
OS2DISPLAY_SCREEN_LAYOUTS="full-screen,three-boxes-horizontal,three-boxes,touch-template,two-boxes,two-boxes-vertical,six-areas,four-areas"

# The domain name of the server (e.g., serv1.example.com) if this needs to be different from the
# application domain. Default is OS2DISPLAY_DOMAIN value
SERVER_DOMAIN="${OS2DISPLAY_DOMAIN}"

# ========================= Docker Compose Values =============================
# @see https://docs.docker.com/compose/how-tos/environment-variables/envvars/

# Sets the project name. This value is prepended along with the service name to the container's name on startup.
# Project names must contain only lowercase letters, decimal digits, dashes, and underscores, and must begin with
# a lowercase letter or decimal digit.
# Note: If you run multiple compose projects on the same server you must use a unique project names for each.
COMPOSE_PROJECT_NAME=os2display

# Enable relevant compose profiles to control included database and proxy.
# @see https://docs.docker.com/compose/how-tos/profiles/

# Have docker compose include a MariaDB database
COMPOSE_PROFILES=mariadb

# Have docker compose include a Traefik proxy
# COMPOSE_PROFILES=traefik

# Have docker compose include both a Traefik proxy and a MariaDB database
# COMPOSE_PROFILES=traefik,mariadb

# Automatically remove orphaned containers when updating a service or stack
COMPOSE_REMOVE_ORPHANS=true
