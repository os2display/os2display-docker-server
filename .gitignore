# Operator-edited environment files (one per service + orchestration).
.env
.env.symfony
.env.php
.env.nginx
.env.mariadb
.env.traefik

# Per-service `.env.<svc>.local` overrides — operator-side override layer
# loaded by docker-compose on top of the matching `.env.<svc>`. See README
# cookbook entry "How do I override env config locally?".
*.local

# Operator-generated by `task host:resources` — host-specific resource limits.
compose.resource-limits.yml
.playwright-mcp/
