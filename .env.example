# =============================================================================
#  Compose orchestration — read by docker compose for substitution into the
#  YAML before parsing. Only contains values that compose itself or compose
#  labels need; everything else is per-service in .env.<service>.
#  Copy to `.env`. Edit COMPOSE_PROFILES + the OS2DISPLAY_* values.
# =============================================================================

##### Compose / project (recognised by docker compose itself) #####

COMPOSE_PROJECT_NAME=os2display

# Built-in infrastructure services to start. Read natively by docker compose.
#   mariadb,traefik   built-in DB + built-in proxy (default for new installs)
#   traefik           external DB, built-in proxy
#   mariadb           built-in DB, external proxy
#   (empty)           both external — operator provides DB and proxy
COMPOSE_PROFILES=mariadb,traefik

##### Substituted into image: tags + traefik labels #####

# Public domain the stack serves.
OS2DISPLAY_SERVER_DOMAIN=os2display.example.com

# Path the admin UI is mounted on. Used by nginx-api's `/` → `/admin` redirect
# middleware. The v3 API image serves the bundled admin UI at this path.
OS2DISPLAY_ADMIN_CLIENT_PATH=/admin

# ghcr.io/os2display/display-api-service tag (api + nginx, both share this version).
# https://github.com/os2display/display-api-service/pkgs/container/display-api-service
OS2DISPLAY_VERSION_API=3.0.0-rc2

# Engine name of the docker network that fronts the stack. Default "frontend".
# Override + include compose.shared-frontend.yml via COMPOSE_FILE if running
# multiple stacks behind one traefik on a shared network.
#OS2DISPLAY_FRONTEND_NETWORK=frontend

##### Log retention #####

# Per-container json-file log driver ceiling: max-size × max-file. The stack
# applies this to every service via the x-logging anchor; defaults give ~30MB
# per container, ~210MB total. Bump for noisy debugging; shrink on tight hosts.
# Inspect current usage with `task host:logs`. Changes take effect on container
# recreate (`task update`), not a plain restart.
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# ----------------------------------------------------------------------------
# Application + runtime config lives in per-service env files:
#   .env.symfony  — Symfony app config (APP_SECRET, DATABASE_URL, JWT, OIDC,
#                   ADMIN_*, CLIENT_*). Bootstrapped via `task env:init`.
#   .env.php      — PHP-FPM runtime tuning (copy from .env.php.production.example).
#   .env.nginx    — NGINX runtime tuning (copy from .env.nginx.production.example).
#   .env.mariadb  — MariaDB credentials  (copy from .env.mariadb.production.example).
#   .env.traefik  — Traefik config       (copy from .env.traefik.production.example).
# ----------------------------------------------------------------------------
