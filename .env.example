# =============================================================================
#  OS2display orchestration config — read by docker compose for substitution.
#  Copy to `.env` and edit.
#  Application config goes in `.env.local` (see `.env.local.example`).
# =============================================================================

##### Compose / project #####

COMPOSE_PROJECT_NAME=os2display

# Public domain the stack serves
OS2DISPLAY_SERVER_DOMAIN=os2display.example.com

# Sub-paths the admin and screen clients are mounted on
OS2DISPLAY_ADMIN_CLIENT_PATH=/admin
OS2DISPLAY_SCREEN_CLIENT_PATH=/client

##### Image versions #####

# itkdev/os2display-api-service tag (api + nginx)
# https://hub.docker.com/r/itkdev/os2display-api-service/tags
OS2DISPLAY_VERSION_API=2.6.0

# itkdev/os2display-admin-client tag
# https://hub.docker.com/r/itkdev/os2display-admin-client/tags
OS2DISPLAY_VERSION_ADMIN=2.6.0

# itkdev/os2display-client tag
# https://hub.docker.com/r/itkdev/os2display-client/tags
OS2DISPLAY_VERSION_CLIENT=2.3.0

##### Templates and screen layouts (loaded by `task load_templates`) #####

# https://github.com/os2display/display-templates/releases
TASK_VERSION_TEMPLATES=2.6.0

TASK_TEMPLATES="book-review,calendar,contacts,iframe,image-text,instagram-feed,poster,rss,slideshow,table,travel,video"

TASK_SCREEN_LAYOUTS="full-screen,three-boxes-horizontal,three-boxes,touch-template,two-boxes,two-boxes-vertical,six-areas,four-areas"

##### Built-in infrastructure toggles #####

# Have docker compose include a MariaDB database (`true`) or use an external one (`false`).
INTERNAL_DATABASE=true

# Have docker compose include a Traefik proxy (`true`) or use an external one (`false`).
INTERNAL_PROXY=true

##### Built-in MariaDB (only used when INTERNAL_DATABASE=true) #####

MARIADB_USER=db
MARIADB_PASSWORD=db
MARIADB_ROOT_PASSWORD=dbrootpassword
MARIADB_DATABASE=db
DB_HOST=mariadb

##### PHP runtime (passed to the os2display service) #####

PHP_MAX_EXECUTION_TIME=30
PHP_MEMORY_LIMIT=128M
PHP_POST_MAX_SIZE=140M
PHP_UPLOAD_MAX_FILESIZE=128M
PHP_PM_MAX_CHILDREN=16

##### nginx-api #####

NGINX_FPM_UPLOAD_MAX=140M

##### admin client (itkdev/os2display-admin-client) #####

# Path the admin frontend uses to reach the API. `/` proxies via traefik.
API_PATH=/

APP_TOUCH_BUTTON_REGIONS=true
APP_REJSEPLANEN_API_KEY=
APP_PREVIEW_CLIENT=
APP_SHOW_SCREEN_STATUS=true

##### screen client (itkdev/os2display-client) #####

APP_API_ENDPOINT=https://demo.os2display.dk
APP_API_PATH=https://demo.os2display.dk
APP_API_AUTHENTICATION_ENDPOINT=https://demo.os2display.dk/v1/authentication/screen
APP_API_AUTHENTICATION_REFRESH_ENDPOINT=https://demo.os2display.dk/v1/authentication/token/refresh
APP_DATA_PULL_INTERVAL=90000
APP_SCHEDULING_INTERVAL=60000
APP_DEBUG=false
