# =============================================================================
#  OS2display orchestration config — read by docker compose for substitution.
#  Copy to `.env` and edit.
#  Application config goes in `.env.local` (see `.env.local.example`).
# =============================================================================

##### Compose / project #####

COMPOSE_PROJECT_NAME=os2display

# Public domain the stack serves
OS2DISPLAY_SERVER_DOMAIN=os2display.example.com

# Path the admin UI is mounted on. Used by nginx-api's `/` → `/admin` redirect
# middleware. The v3 API image serves the bundled admin UI at this path.
OS2DISPLAY_ADMIN_CLIENT_PATH=/admin

##### Image versions #####

# ghcr.io/os2display/display-api-service tag (api + nginx, both share this version).
# The v3 API image bundles the admin and screen-client UIs and serves them
# via Symfony routes — there is no separate admin/client image to pin.
# https://github.com/os2display/display-api-service/pkgs/container/display-api-service
OS2DISPLAY_VERSION_API=3.0.0-rc1

##### Stack composition #####

# Built-in infrastructure services to start. Read natively by docker compose.
#   mariadb,traefik   built-in DB + built-in proxy (default for new installs)
#   traefik           external DB, built-in proxy
#   mariadb           built-in DB, external proxy
#   (empty)           both external — operator provides DB and proxy
COMPOSE_PROFILES=mariadb,traefik

##### Built-in MariaDB (only used when COMPOSE_PROFILES contains `mariadb`) #####

MARIADB_USER=db
MARIADB_PASSWORD=db
MARIADB_ROOT_PASSWORD=dbrootpassword
MARIADB_DATABASE=db
DB_HOST=mariadb

##### PHP runtime (passed to the os2display service) #####

PHP_MAX_EXECUTION_TIME=30
PHP_MEMORY_LIMIT=128M
PHP_POST_MAX_SIZE=140M
PHP_UPLOAD_MAX_FILESIZE=128M
PHP_PM_MAX_CHILDREN=16

##### nginx-api #####

# Max request body size accepted by nginx (must be >= PHP_UPLOAD_MAX_FILESIZE).
NGINX_MAX_BODY_SIZE=140m

# Admin and screen-client behaviour is configured via ADMIN_* and CLIENT_*
# env vars in `.env.local` (passed to the os2display container via env_file:).
# Run `task env:init` to extract the annotated example from the API image.
